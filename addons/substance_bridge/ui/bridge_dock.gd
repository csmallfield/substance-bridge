@tool
extends VBoxContainer
## Substance Bridge dock.
##
## Workflow: pick an .sbsar -> "Create and Apply" makes a GraphSettings resource, renders a
## preview and applies the material to the selected meshes. Edit the graph's parameters in
## the Inspector ("Edit Parameters"); each change re-renders a preview after a short pause.
## "Render Final" renders the same settings at the final size.
##
## The current material follows the Inspector (editing a *_graph.tres) and the selection
## (a MeshInstance3D whose material was generated by the bridge).

const Settings := preload("res://addons/substance_bridge/core/settings.gd")
const GraphSettings := preload("res://addons/substance_bridge/core/graph_settings.gd")
const Pipeline := preload("res://addons/substance_bridge/core/pipeline.gd")

const LAST_SBSAR_META := "substance_bridge_last_sbsar"
const PREVIEW_DELAY_SEC := 0.35

enum Job { NONE, PREVIEW, FINAL }

var undo_redo: EditorUndoRedoManager

var current: GraphSettings:
	set = set_current

var _pipeline := Pipeline.new()
var _busy := false
var _pending := Job.NONE
var _debounce: Timer

var _sbsar_edit: LineEdit
var _create_button: Button
var _current_label: Label
var _edit_button: Button
var _bake_button: Button
var _auto_check: CheckBox
var _preview_button: Button
var _final_button: Button
var _status: Label
var _log: TextEdit
var _file_dialog: EditorFileDialog


func _init() -> void:
	name = "Substance Bridge"
	custom_minimum_size = Vector2(240, 0)
	_pipeline.log_callback = log_line

	add_child(_heading("New material"))
	var src_row := HBoxContainer.new()
	_sbsar_edit = LineEdit.new()
	_sbsar_edit.placeholder_text = ".sbsar file"
	_sbsar_edit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var browse := Button.new()
	browse.text = "..."
	browse.tooltip_text = "Choose an .sbsar file"
	browse.pressed.connect(_on_browse)
	src_row.add_child(_sbsar_edit)
	src_row.add_child(browse)
	add_child(src_row)
	_create_button = Button.new()
	_create_button.text = "Create and Apply to Selected"
	_create_button.tooltip_text = "Make a new material from this .sbsar, render a preview and apply it to the selected MeshInstance3D nodes."
	_create_button.pressed.connect(_on_create_pressed)
	add_child(_create_button)

	add_child(HSeparator.new())
	add_child(_heading("Current material"))
	_current_label = Label.new()
	_current_label.text = "(none: create one, or select a mesh that uses one)"
	_current_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	add_child(_current_label)

	_edit_button = Button.new()
	_edit_button.text = "Edit Parameters"
	_edit_button.tooltip_text = "Show the graph's parameters in the Inspector."
	_edit_button.pressed.connect(func() -> void:
		if current:
			EditorInterface.edit_resource(current))
	add_child(_edit_button)

	_bake_button = Button.new()
	_bake_button.text = "Bake from Selected Mesh"
	_bake_button.tooltip_text = "Bake this graph's mesh maps (AO, curvature, ...) from the selected MeshInstance3D and re-render."
	_bake_button.pressed.connect(_on_bake_pressed)
	add_child(_bake_button)

	_auto_check = CheckBox.new()
	_auto_check.text = "Auto preview on change"
	_auto_check.toggled.connect(func(on: bool) -> void:
		if current and current.auto_preview != on:
			current.auto_preview = on
			ResourceSaver.save(current, current.resource_path))
	add_child(_auto_check)

	var row := HBoxContainer.new()
	_preview_button = Button.new()
	_preview_button.text = "Preview"
	_preview_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_preview_button.pressed.connect(func() -> void: _queue(Job.PREVIEW))
	_final_button = Button.new()
	_final_button.text = "Render Final"
	_final_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_final_button.pressed.connect(func() -> void: _queue(Job.FINAL))
	row.add_child(_preview_button)
	row.add_child(_final_button)
	add_child(row)

	_status = Label.new()
	_status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	add_child(_status)

	_log = TextEdit.new()
	_log.editable = false
	_log.custom_minimum_size = Vector2(0, 140)
	_log.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_log.wrap_mode = TextEdit.LINE_WRAPPING_BOUNDARY
	add_child(_log)

	_debounce = Timer.new()
	_debounce.one_shot = true
	_debounce.wait_time = PREVIEW_DELAY_SEC
	_debounce.timeout.connect(func() -> void: _queue(Job.PREVIEW))
	add_child(_debounce)
	_refresh()


func _ready() -> void:
	_file_dialog = EditorFileDialog.new()
	_file_dialog.file_mode = EditorFileDialog.FILE_MODE_OPEN_FILE
	_file_dialog.access = EditorFileDialog.ACCESS_FILESYSTEM
	_file_dialog.add_filter("*.sbsar", "Substance archive")
	_file_dialog.file_selected.connect(func(path: String) -> void: _sbsar_edit.text = path)
	add_child(_file_dialog)
	_sbsar_edit.text = String(EditorInterface.get_editor_settings().get_project_metadata(
			"substance_bridge", LAST_SBSAR_META, ""))
	EditorInterface.get_inspector().edited_object_changed.connect(_on_inspector_object_changed)
	EditorInterface.get_selection().selection_changed.connect(_on_selection_changed)


func set_status(text: String) -> void:
	_status.text = text


func log_line(text: String) -> void:
	_log.text += text + "\n"
	_log.scroll_vertical = _log.get_line_count()
	print("[Substance Bridge] ", text)


func is_busy() -> bool:
	return _busy or _pending != Job.NONE or not _debounce.is_stopped()


func set_current(gs: GraphSettings) -> void:
	if gs == current:
		return
	if current and current.parameters_changed.is_connected(_on_parameters_changed):
		current.parameters_changed.disconnect(_on_parameters_changed)
		current.description_loaded.disconnect(_refresh)
	current = gs
	if current:
		current.parameters_changed.connect(_on_parameters_changed)
		current.description_loaded.connect(_refresh)
	_refresh()


# --- create ---------------------------------------------------------------------------------

func _on_browse() -> void:
	if not _sbsar_edit.text.is_empty():
		_file_dialog.current_dir = _sbsar_edit.text.get_base_dir()
	_file_dialog.popup_file_dialog()


func _on_create_pressed() -> void:
	var targets := _selected_meshes()
	if targets.is_empty():
		set_status("Select one or more MeshInstance3D nodes first.")
		return
	await create_material(_sbsar_edit.text.strip_edges(), targets)


## Creates settings for an .sbsar, renders a preview and applies the material to targets.
## Returns the new GraphSettings, or null. Also used by the self-test.
func create_material(sbsar: String, targets: Array[MeshInstance3D]) -> GraphSettings:
	if _busy:
		set_status("Busy; try again when the current render finishes.")
		return null
	if not FileAccess.file_exists(sbsar):
		set_status("Choose an existing .sbsar file.")
		return null
	EditorInterface.get_editor_settings().set_project_metadata("substance_bridge", LAST_SBSAR_META, sbsar)
	var gs := _pipeline.create_settings(sbsar)
	if gs == null:
		set_status("Could not create the settings resource. See the log.")
		return null
	set_current(gs)
	if not gs.is_described():
		set_status("Reading %s..." % sbsar.get_file())
		await gs.description_loaded
	# Mesh-adaptive graph: bake its mesh maps from the first selected mesh.
	if not gs.mesh_usages().is_empty():
		_busy = true
		_refresh()
		set_status("Exporting %s for baking..." % targets[0].name)
		var err: String = await _pipeline.set_mesh(gs, targets[0])
		_busy = false
		if not err.is_empty():
			set_status(err)
			return gs
	await _run(Job.PREVIEW)
	if gs.material:
		apply_material(gs.material, targets)
		EditorInterface.edit_resource(gs)
	return gs


func _on_bake_pressed() -> void:
	var targets := _selected_meshes()
	if current == null or targets.is_empty():
		set_status("Select the MeshInstance3D to bake from.")
		return
	await bake_from_mesh(targets[0])


## Points the current settings at a mesh, re-renders (baking its maps) and applies the
## material to it. Also used by the self-test.
func bake_from_mesh(mi: MeshInstance3D) -> void:
	if current == null or _busy:
		return
	_busy = true
	_refresh()
	set_status("Exporting %s for baking..." % mi.name)
	var err: String = await _pipeline.set_mesh(current, mi)
	_busy = false
	_debounce.stop()  # set_mesh changed the settings; render once, now
	if not err.is_empty():
		set_status(err)
		_refresh()
		return
	await _run(Job.PREVIEW)
	if current.material and mi.material_override != current.material:
		apply_material(current.material, [mi] as Array[MeshInstance3D])


func apply_material(mat: Material, targets: Array[MeshInstance3D]) -> void:
	undo_redo.create_action("Apply Substance material")
	var count := 0
	for mi in targets:
		if not is_instance_valid(mi):
			continue
		undo_redo.add_do_property(mi, "material_override", mat)
		undo_redo.add_undo_property(mi, "material_override", mi.material_override)
		count += 1
	undo_redo.commit_action()
	log_line("Applied to %d mesh(es)." % count)


# --- preview / final ----------------------------------------------------------------------------

func _on_parameters_changed() -> void:
	if current and current.auto_preview:
		_debounce.start()
	_refresh()


func _queue(job: Job) -> void:
	if _busy:
		# Remember the most important pending job; FINAL wins over PREVIEW.
		_pending = maxi(_pending, job) as Job
		return
	await _run(job)


func _run(job: Job) -> void:
	var gs := current
	if gs == null or job == Job.NONE:
		return
	_busy = true
	_refresh()
	var size: int = gs.final_size if job == Job.FINAL else gs.preview_size
	set_status("Rendering %s at %s..." % [gs.output_name, gs.size_name(size)])
	var out: Dictionary = await _pipeline.render(gs, size)
	_busy = false
	if out.has("error"):
		set_status("Render failed: %s" % out["error"])
	elif out.get("skipped", false):
		set_status("Up to date at %s." % gs.size_name(size))
	else:
		set_status("%s at %s (%.1f s)." % ["Final" if job == Job.FINAL else "Preview",
				gs.size_name(size), out["seconds"]])
	_refresh()
	if _pending != Job.NONE:
		var next := _pending
		_pending = Job.NONE
		await _queue(next)


# --- tracking the current material ------------------------------------------------------------

func _on_inspector_object_changed() -> void:
	var obj := EditorInterface.get_inspector().get_edited_object()
	if obj is Resource and obj.get_script() == GraphSettings:
		set_current(obj)


func _on_selection_changed() -> void:
	for mi in _selected_meshes():
		var gs := Pipeline.settings_for_material(mi.material_override)
		if gs:
			set_current(gs)
			return


func _selected_meshes() -> Array[MeshInstance3D]:
	var targets: Array[MeshInstance3D] = []
	for node in EditorInterface.get_selection().get_selected_nodes():
		if node is MeshInstance3D:
			targets.append(node)
	return targets


func _refresh() -> void:
	# After a script hot-reload the live dock keeps its old controls; members added since are
	# null until the plugin is re-enabled. Skip the refresh rather than error on every change.
	if _bake_button == null or _final_button == null:
		return
	var has := current != null
	var mesh_usages := current.mesh_usages() if has else PackedStringArray()
	_edit_button.disabled = not has
	_auto_check.disabled = not has
	_preview_button.disabled = not has or _busy
	_final_button.disabled = not has or _busy
	_create_button.disabled = _busy
	_bake_button.visible = not mesh_usages.is_empty()
	_bake_button.disabled = _busy
	if has:
		_auto_check.set_pressed_no_signal(current.auto_preview)
		var mesh_line := ""
		if not mesh_usages.is_empty():
			mesh_line = "\nmesh maps (%s) at %s from %s" % [", ".join(mesh_usages),
					current.size_name(current.bake_size),
					current.baked_mesh if not current.baked_mesh.is_empty() else "(no mesh yet)"]
		_current_label.text = "%s\npreview %s, final %s, %d changed parameter(s)%s" % [
				current.output_name, current.size_name(current.preview_size),
				current.size_name(current.final_size), current.values.size(), mesh_line]
		_final_button.text = "Render Final (%s)" % current.size_name(current.final_size)
	else:
		_current_label.text = "(none: create one, or select a mesh that uses one)"
		_final_button.text = "Render Final"


func _heading(text: String) -> Label:
	var l := Label.new()
	l.text = text
	l.theme_type_variation = &"HeaderSmall"
	return l
